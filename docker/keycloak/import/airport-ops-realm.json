{
  "realm": "airport-ops",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "PLATFORM_ADMIN",
        "description": "Platform administrator role for the Airport Ops local lab"
      }
    ]
  },
  "clients": [
    {
      "clientId": "airport-ops-local",
      "name": "Airport Ops Local",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:*/*"
      ],
      "webOrigins": [
        "*"
      ]
    },
    {
      "clientId": "iam-service-admin",
      "name": "IAM Service Admin",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${IAM_SERVICE_ADMIN_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "iam-service-session",
      "name": "IAM Service Browser Session",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_SESSION_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "platform.admin@demo.com",
      "firstName": "Platform",
      "lastName": "Admin",
      "email": "platform.admin@demo.com",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "realmRoles": [
        "PLATFORM_ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-iam-service-admin",
      "enabled": true,
      "serviceAccountClientId": "iam-service-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    }
  ]
}
